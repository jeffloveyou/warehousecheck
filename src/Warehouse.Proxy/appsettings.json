{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "all": {
        "ClusterId": "app",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "app": {
        "HttpRequest": { "ActivityTimeout": "00:01:40" }
      }
    }
  }
}
