@page "{id:guid}"
@model Warehouse.Web.Pages.Items.DetailsModel
@{
    var item = Model.Item;
    ViewData["Title"] = item.ItemCode ?? item.RequestNo;
    var pending = item.Status == ItemStatus.PendingApproval;
    var canEdit = item.Status != ItemStatus.Rejected
        && (Model.IsManager || (Model.IsSubmitter && item.Status is ItemStatus.PendingApproval or ItemStatus.Returned));
}
<h1>@(item.ItemCode ?? "（尚無料號）") <span class="status-@item.Status">@Display.Of(item.Status)</span></h1>
@if (TempData["Message"] is string message)
{
    <div class="message info" id="page-message">@message</div>
}
@if (Model.Error is not null)
{
    <div class="message error" id="page-error">@Model.Error</div>
}

<dl class="status">
    <dt>申請單號</dt><dd id="request-no">@item.RequestNo</dd>
    <dt>正式料號</dt><dd id="item-code">@(item.ItemCode ?? "核准後產生")</dd>
    <dt>品名</dt><dd>@item.Name</dd>
    <dt>分類</dt><dd>@item.CategoryName</dd>
    <dt>基本單位</dt><dd>@item.UnitCode</dd>
    <dt>追蹤模式</dt><dd>@Display.Of(item.TrackingMode)</dd>
    <dt>品牌</dt><dd>@item.Brand</dd>
    <dt>原廠型號</dt><dd>@item.ManufacturerPartNo</dd>
    <dt>規格</dt><dd style="white-space: pre-line">@item.Specification</dd>
    <dt>負庫存</dt><dd>@(item.AllowNegativeStock ? $"允許，下限 -{item.NegativeStockLimit:0.####}" : "不允許")</dd>
    <dt>建立／更新</dt><dd>@Display.Time(item.CreatedAt) ／ @Display.Time(item.UpdatedAt)</dd>
</dl>

<div class="actions">
    @if (canEdit)
    {
        <a href="/Items/Edit/@item.Id" id="item-edit-link">@(item.Status == ItemStatus.Returned ? "修改並重新送審" : "修改")</a>
    }
    <a href="/Items">回清單</a>
</div>

@if (pending && Model.IsManager)
{
    <form method="post" class="panel" id="review-form">
        <h2>審核</h2>
        <input type="hidden" asp-for="Version" />
        @if (Model.Candidates.Count > 0)
        {
            <div class="message warn">有 @Model.Candidates.Count 筆可能重複的物料。核准前請逐筆勾選「確認不同」；若確實重複，請選擇後按「判定重複並拒絕」。</div>
            <partial name="_DuplicateCandidates" model="(Model.Candidates, true)" />
            <p>
                <label for="DuplicateOfItemId">重複於</label>
                <select id="DuplicateOfItemId" name="DuplicateOfItemId">
                    <option value="">（不是重複）</option>
                    @foreach (var c in Model.Candidates)
                    {
                        <option value="@c.ItemId">@(c.ItemCode ?? c.RequestNo) @c.Name</option>
                    }
                </select>
            </p>
        }
        else
        {
            <p class="muted">沒有找到可能重複的物料。</p>
        }
        <p>
            <label for="RequestedItemCode">正式料號（空白＝自動流水號）</label>
            <input type="text" id="RequestedItemCode" name="RequestedItemCode" value="@Model.RequestedItemCode" maxlength="@Warehouse.Domain.Items.Item.ItemCodeMaxLength"
                   placeholder="@(Model.CodeOptions.Prefixes.Count > 0 ? $"例：{Model.CodeOptions.Prefixes[0]}-000123" : "")" autocomplete="off" />
            @if (Model.CodeOptions.Prefixes.Count > 0)
            {
                <span class="muted">可用前綴：@string.Join("、", Model.CodeOptions.Prefixes)（分類與上層分類）；格式為前綴-至少 6 位數字。</span>
            }
        </p>
        <p><label for="Comment">意見（退回、拒絕必填）</label><textarea id="Comment" name="Comment" maxlength="@ItemReview.CommentMaxLength"></textarea></p>
        <div class="actions">
            <button type="submit" asp-page-handler="Approve" id="approve-button">核准並發料號</button>
            <button type="submit" asp-page-handler="Return" class="secondary" id="return-button">退回修改</button>
            <button type="submit" asp-page-handler="Reject" class="danger" id="reject-button">@(Model.Candidates.Count > 0 ? "判定重複並拒絕" : "拒絕")</button>
        </div>
    </form>
}

@if (Model.IsSubmitter && item.Status is ItemStatus.PendingApproval or ItemStatus.Returned)
{
    <form method="post" asp-page-handler="Withdraw" class="panel" id="withdraw-form">
        <input type="hidden" asp-for="Version" />
        <label for="WithdrawComment">撤回原因（選填）</label>
        <input type="text" id="WithdrawComment" name="Comment" maxlength="@ItemReview.CommentMaxLength" />
        <div class="actions"><button type="submit" class="secondary" id="withdraw-button">撤回申請</button></div>
    </form>
}

@if (Model.IsManager && item.Status is ItemStatus.Active or ItemStatus.Inactive)
{
    var active = item.Status == ItemStatus.Active;
    <form method="post" asp-page-handler="@(active ? "Deactivate" : "Reactivate")" class="panel" id="active-form">
        <input type="hidden" asp-for="Version" />
        <label for="ActiveComment">原因（選填）</label>
        <input type="text" id="ActiveComment" name="Comment" maxlength="@ItemReview.CommentMaxLength" />
        <div class="actions"><button type="submit" class="@(active ? "danger" : "")" id="active-button">@(active ? "停用（料號保留）" : "重新啟用")</button></div>
    </form>
}

@if (Model.CanChangeItemCode)
{
    <form method="post" asp-page-handler="ChangeItemCode" class="panel" id="item-code-form">
        <h2>變更料號</h2>
        <input type="hidden" asp-for="Version" />
        <p class="muted">單據、庫存都以物料內部識別碼關聯，變更後歷史紀錄會顯示新料號。可用前綴：@string.Join("、", Model.CodeOptions.Prefixes)。已印出的舊標籤請盡快換新。</p>
        <div class="form-grid">
            <label for="NewItemCode">新料號</label>
            <input type="text" id="NewItemCode" name="NewItemCode" value="@Model.NewItemCode" maxlength="@Warehouse.Domain.Items.Item.ItemCodeMaxLength" autocomplete="off" required />
            <label for="CodeChangeReason">原因（必填）</label>
            <input type="text" id="CodeChangeReason" name="CodeChangeReason" value="@Model.CodeChangeReason" maxlength="@ItemCodeHistory.ReasonMaxLength" required />
            <span>舊料號 @item.ItemCode</span>
            <span>
                <label><input type="radio" name="ReleaseOldCode" value="false" checked="@(!Model.ReleaseOldCode)" /> 保留為歷史料號（仍可搜尋、掃碼找到這個物料，不給其他物料使用）</label><br />
                <label><input type="radio" name="ReleaseOldCode" value="true" checked="@Model.ReleaseOldCode" id="release-old-code" /> 釋出（之後查不到，其他物料可以使用）</label>
            </span>
            <label for="ConfirmOldCode">釋出時再輸入一次舊料號</label>
            <input type="text" id="ConfirmOldCode" name="ConfirmOldCode" maxlength="@Warehouse.Domain.Items.Item.ItemCodeMaxLength" autocomplete="off" />
        </div>
        <div class="actions"><button type="submit" id="item-code-change-button">變更料號</button></div>
    </form>
}
@if (Model.CodeOptions.History.Count > 0)
{
    <h2 id="item-code-history">歷史料號</h2>
    <div class="table-wrap">
        <table id="item-code-history-list">
            <thead><tr><th>舊料號</th><th>改為</th><th>處理</th><th>原因</th><th>操作者</th><th>時間</th></tr></thead>
            <tbody>
                @foreach (var h in Model.CodeOptions.History)
                {
                    <tr>
                        <td>@h.Code</td>
                        <td>@h.NewCode</td>
                        <td>@(h.Released ? "已釋出" : "保留")</td>
                        <td>@h.Reason</td>
                        <td>@h.ActorName</td>
                        <td>@Display.Time(h.OccurredAt)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 id="negative-policy">負庫存</h2>
<p class="muted">目前：@(item.AllowNegativeStock ? $"允許，下限 -{item.NegativeStockLimit:0.####}" : "不允許")。只有不追蹤批號／序號的物料可以設定。下限是這個料號「全倉合計可用量」的最低值（例如下限 5，合計可用量最低可到 -5）。</p>
@if (Model.CanEditNegativePolicy)
{
    <form method="post" asp-page-handler="NegativePolicy" class="panel" id="negative-policy-form">
        <input type="hidden" asp-for="Version" />
        <div class="form-grid">
            <span></span>
            <label><input type="checkbox" name="AllowNegative" value="true" checked="@Model.AllowNegative" /> 允許負庫存</label>
            <label for="NegativeLimit">下限（正數，基本單位）</label>
            <input type="number" id="NegativeLimit" name="NegativeLimit" value="@Model.NegativeLimit.ToString("0.####")" min="0" step="any" />
        </div>
        <p class="muted">已有負結存時不能關閉，也不能把下限調得比目前的負數還小。每次修改都會留下稽核紀錄。</p>
        <div class="actions"><button type="submit" id="negative-policy-save">儲存負庫存設定</button></div>
    </form>
}

<h2 id="index">搜尋索引</h2>
<p class="muted">專屬別名：全系統只能對應這一個物料。共用關鍵字：俗稱、用途，可同時掛在多個物料。原廠條碼：包裝上的條碼，掃到就精確對應這個物料（只收英數字，可設包裝數量）。停用後不再被搜尋或掃到，紀錄保留。</p>
@if (Model.CanAddIndex)
{
    <form method="post" asp-page-handler="AddIndex" class="filters" id="index-form">
        <input type="text" name="IndexText" value="@Model.IndexText" maxlength="@ItemAlias.TextMaxLength" placeholder="例：伺服AMP、維修用放大器，或掃描包裝條碼" aria-label="索引文字" autocomplete="off" required
               data-camera-field="raw" data-camera-kind-select="index-kind" />
        <select name="IndexKind" aria-label="索引類型" id="index-kind">
            <option value="Keyword" selected="@(Model.IndexKind == ItemIndexKind.Keyword)">共用關鍵字</option>
            <option value="Alias" selected="@(Model.IndexKind == ItemIndexKind.Alias)">專屬別名</option>
            <option value="Barcode" selected="@(Model.IndexKind == ItemIndexKind.Barcode)">原廠條碼</option>
        </select>
        <input type="number" name="IndexPackQuantity" value="@Model.IndexPackQuantity" min="0" step="any" placeholder="包裝數量（條碼用，預設 1）" aria-label="包裝數量" id="index-pack-quantity" />
        <button type="submit" id="index-add">新增</button>
    </form>
    @if (Model.SuggestKeyword is not null)
    {
        <form method="post" asp-page-handler="AddIndex" id="suggest-keyword-form">
            <input type="hidden" name="IndexText" value="@Model.SuggestKeyword" />
            <input type="hidden" name="IndexKind" value="Keyword" />
            <button type="submit" class="secondary" id="suggest-keyword">改加為共用關鍵字「@Model.SuggestKeyword」</button>
        </form>
    }
}
else if (item.Status != ItemStatus.Active)
{
    <p class="muted">物料核准且有效後才能新增搜尋索引。</p>
}
<div class="table-wrap">
    <table id="index-list">
        <thead><tr><th>類型</th><th>文字</th><th>使用中料號數／包裝</th><th>建立</th><th>狀態</th><th></th></tr></thead>
        <tbody>
            @foreach (var x in Model.Indexes)
            {
                <tr class="@(x.IsActive ? "" : "muted")">
                    <td>@Display.Of(x.Kind)@(x.Symbology is { } sym ? $"（{sym}）" : "")</td>
                    <td>@x.Text</td>
                    <td>@(x.Kind == ItemIndexKind.Keyword && x.IsActive ? x.UsageCount.ToString() : x.PackQuantity is { } pack ? $"每掃一次 {Display.Qty(pack)}" : "")</td>
                    <td>@x.CreatedByName @Display.Time(x.CreatedAt)</td>
                    <td>@(x.IsActive ? "有效" : $"已停用（{x.DeactivatedByName} {(x.DeactivatedAt is { } at ? Display.Time(at) : "")}）")</td>
                    <td>
                        @if (x.IsActive && (Model.IsManager || x.CreatedById == User.ToActor().Id))
                        {
                            <form method="post" asp-page-handler="DeactivateIndex" class="inline">
                                <input type="hidden" name="entryId" value="@x.Id" />
                                <input type="hidden" name="kind" value="@x.Kind" />
                                <button type="submit" class="link">停用</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Indexes.Count == 0)
            {
                <tr><td colspan="6" class="muted">尚未建立搜尋索引。</td></tr>
            }
        </tbody>
    </table>
</div>

<h2 id="item-locations">常用倉位</h2>
<p class="muted">入庫、期初時會優先建議這些儲位（只是建議，仍由人選擇）。每個倉庫最多一個預設倉位。</p>
<div class="table-wrap">
    <table id="item-location-list">
        <thead><tr><th>倉庫</th><th>儲位</th><th>預設</th><th>儲位狀態</th><th></th></tr></thead>
        <tbody>
            @foreach (var x in Model.ItemLocations)
            {
                <tr>
                    <td>@x.WarehouseCode</td>
                    <td><a href="/Warehouses/Location/@x.LocationId">@x.LocationCode</a></td>
                    <td>@(x.IsDefault ? "預設" : "")</td>
                    <td>@Display.Of(x.LocationStatus)</td>
                    <td>
                        @if (Model.CanManageLocations)
                        {
                            @if (!x.IsDefault)
                            {
                                <form method="post" asp-page-handler="DefaultItemLocation" class="inline">
                                    <input type="hidden" name="itemLocationId" value="@x.Id" />
                                    <button type="submit" class="link">設為預設</button>
                                </form>
                            }
                            <form method="post" asp-page-handler="RemoveItemLocation" class="inline">
                                <input type="hidden" name="itemLocationId" value="@x.Id" />
                                <button type="submit" class="link">移除</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.ItemLocations.Count == 0)
            {
                <tr><td colspan="5" class="muted">尚未設定。</td></tr>
            }
        </tbody>
    </table>
</div>
@if (Model.CanManageLocations)
{
    <form method="post" asp-page-handler="AddItemLocation" class="filters" id="item-location-form">
        <select name="warehouseId" aria-label="倉庫" required>
            @foreach (var w in Model.Warehouses)
            {
                <option value="@w.Id">@w.Code @w.Name</option>
            }
        </select>
        <input type="text" name="locationCode" maxlength="40" placeholder="儲位碼" aria-label="儲位碼" required />
        <label><input type="checkbox" name="isDefault" value="true" /> 預設</label>
        <button type="submit" id="item-location-add">新增常用倉位</button>
    </form>
}

<h2>審核紀錄</h2>
<div class="table-wrap">
    <table id="review-history">
        <thead><tr><th>時間</th><th>動作</th><th>狀態</th><th>操作者</th><th>意見</th></tr></thead>
        <tbody>
            @foreach (var r in item.Reviews)
            {
                <tr>
                    <td>@Display.Time(r.OccurredAt)</td>
                    <td>@Display.Of(r.Action)@(r.ItemCode is null ? "" : $"（{r.ItemCode}）")</td>
                    <td>@Display.Of(r.FromStatus) → @Display.Of(r.ToStatus)</td>
                    <td>@r.ActorName</td>
                    <td>
                        @r.Comment
                        @if (r.DuplicateOfItemId is { } dup)
                        {
                            <div>重複於 <a href="/Items/Details/@dup">@r.DuplicateOfLabel</a></div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    @if (Model.CanAddIndex)
    {
        @* 新增索引的相機按鈕（docs/04 §6.2）：填原始條碼，索引類型自動改為原廠條碼 *@
        <script src="~/js/scan-input.js" asp-append-version="true"></script>
        <script src="~/js/scan-field.js" asp-append-version="true"></script>
        <script src="~/js/camera-field.js" asp-append-version="true"></script>
    }
}
