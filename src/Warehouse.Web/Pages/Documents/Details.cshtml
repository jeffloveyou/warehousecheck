@page "{id:guid}"
@model Warehouse.Web.Pages.Documents.DetailsModel
@using Warehouse.Domain.Inventory
@using Warehouse.Application.Warehousing
@using Warehouse.Web.Pages.Documents
@{
    var d = Model.Doc;
    var s = Model.Settings;
    var isTransfer = d.DocType == StockDocumentType.Transfer;
    var isInbound = d.DocType == StockDocumentType.Inbound;
    var isOutbound = d.DocType == StockDocumentType.Outbound;
    ViewData["Title"] = d.DocNo;
    ViewData["UsesPrefs"] = true; // 明細輸入區的常用設定（M8-06）
}
<h1>@d.DocNo <span class="muted">@Display.Of(d.DocType) @d.WarehouseCode</span> @Display.Of(d.Status)</h1>
@if (TempData["Message"] is string message)
{
    <div class="message info" id="page-message">@message</div>
}
@if (Model.Error is not null)
{
    <div class="message error" id="page-error">@Model.Error</div>
}
@if (d.ReturnComment is not null && d.Status == StockDocumentStatus.Draft)
{
    <div class="message warn">退回原因：@d.ReturnComment</div>
}
@if (d.ReversalOfDocumentId is { } originalId)
{
    <div class="message info">這是 <a href="/Documents/Details/@originalId">@d.ReversalOfDocNo</a> 的沖銷單（方向相反，過帳後抵銷原單）。</div>
}
<dl class="status">
    <dt>類型</dt><dd>@Display.Of(d.DocType)</dd>
    <dt>倉庫</dt><dd>@d.WarehouseCode</dd>
    @if (!isTransfer && (s.DocumentPurposeEnabled || d.PurposeName is not null))
    {
        <dt>用途</dt><dd>@d.PurposeName</dd>
    }
    @if (s.DocumentPartnerEnabled || d.PartnerName is not null)
    {
        <dt>往來對象</dt><dd>@d.PartnerName</dd>
    }
    @if (s.DocumentExternalNoEnabled || d.ExternalNo is not null)
    {
        <dt>外部單號</dt><dd>@d.ExternalNo</dd>
    }
    @if (s.DocumentNoteEnabled || d.Note is not null)
    {
        <dt>備註</dt><dd>@d.Note</dd>
    }
    <dt>建立</dt><dd>@d.CreatedByName @Display.Time(d.CreatedAt)</dd>
    <dt>送審</dt><dd>@(d.SubmittedAt is { } submittedAt ? Display.Time(submittedAt) : "")</dd>
    <dt>核准／過帳</dt><dd>@d.ApprovedByName @(d.PostedAt is { } postedAt ? Display.Time(postedAt) : "")</dd>
</dl>

@if (Model.CanEdit && Model.HeaderOptions is { } headerOptions)
{
    <form method="post" asp-page-handler="UpdateHeader" class="panel" id="document-header-form">
        <h2>修改表頭</h2>
        <input type="hidden" name="Version" value="@Model.Version" />
        <div class="form-grid">
            <partial name="_HeaderFields" model="new HeaderFieldsModel(headerOptions, Model.Header, d.DocType)" />
        </div>
        <div class="actions"><button type="submit" class="secondary" id="document-save-header">儲存表頭</button></div>
    </form>
}

@* 掃碼面板放在明細表上面：明細很多時（尤其手機）不必捲到最下面才能掃 *@
@if (Model.CanEdit)
{
    <partial name="_ScanPanel" model="Model.ScanPanel" />
}
<partial name="_DocumentLines" model="Model" />

@if (Model.CanEdit)
{
    @* 沒有 JS 時的傳統表單（ADR-0003）：有 JS 時 doc-scan.js 收起來，只用上方的明細輸入區 *@
    <div class="panel" id="document-add-line-panel" data-entry-fallback>
        <h2>新增明細（搜尋＋點選）</h2>
        <form method="get" class="filters" id="item-search-form">
            <input type="text" name="ItemQuery" value="@Model.ItemQuery" maxlength="200" placeholder="輸入或掃描料號，按 Enter 搜尋" aria-label="搜尋料號" autocomplete="off" />
            <button type="submit" class="secondary" id="item-search-submit">搜尋</button>
            <a href="/Search" target="_blank" rel="noopener">進階搜尋</a>
        </form>
        @if (Model.SearchNotice is not null)
        {
            <div class="message warn" id="search-notice">@Model.SearchNotice</div>
        }
        @if (Model.Resolved is { } item)
        {
            <p id="resolved-item"><strong>@item.ItemCode</strong> @item.Name <span class="muted">@item.SpecificationSummary（單位 @item.UnitCode）</span></p>
        }
        @if (Model.Candidates.Count > 0)
        {
            <div class="table-wrap">
                <table id="item-candidates">
                    <thead><tr><th>料號</th><th>品名</th><th>型號／規格</th><th>分類</th><th>單位</th><th>命中</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Candidates)
                        {
                            <tr>
                                <td>@c.ItemCode</td>
                                <td>@c.Name</td>
                                <td>@c.ManufacturerPartNo @c.SpecificationSummary</td>
                                <td>@c.CategoryName</td>
                                <td>@c.UnitCode</td>
                                <td>@Display.Of(c.Reason)</td>
                                <td><a href="@Model.CandidateUrl(c.ItemCode!)">選擇</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted">候選只是搜尋結果，請確認料號與規格後再選擇。</p>
        }
        @if (Model.Suggestions is { } suggestions)
        {
            <p id="suggestions">
                建議儲位：
                @if (suggestions.Count == 0)
                {
                    <span class="muted">沒有建議（尚未設定常用倉位、也沒有庫存）。</span>
                }
                @foreach (var sg in suggestions)
                {
                    <a href="#" class="chip fill-line" data-location="@sg.LocationCode" data-focus="Line_Quantity">@sg.LocationCode（@(sg.Reason switch { SuggestionReason.Default => "預設", SuggestionReason.Frequent => "常用", _ => "有庫存" })@(sg.QuantityHere > 0 ? $"，現有 {Display.Qty(sg.QuantityHere)}" : "")）</a>
                }
            </p>
        }
        @if (Model.Balances is { } balances)
        {
            <h3>本倉結存（@Model.Resolved?.ItemCode）</h3>
            <div class="table-wrap">
                <table id="item-balances">
                    <thead><tr><th>儲位</th><th>批號</th><th>序號</th><th>有效期限</th><th>狀態</th><th>數量</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var b in balances.Items)
                        {
                            <tr>
                                <td>@b.LocationCode</td>
                                <td>@b.LotNo</td>
                                <td>@b.SerialNo</td>
                                <td>@(b.ExpiryDate?.ToString("yyyy-MM-dd"))</td>
                                <td>@(b.LocationAvailable ? Display.Of(b.Status) : "待驗儲位")</td>
                                <td class="num">@Display.Qty(b.Quantity) @b.UnitCode</td>
                                <td><a href="#" class="fill-line" data-location="@b.LocationCode" data-lot="@(b.LotNo ?? "")" data-serial="@(b.SerialNo ?? "")">帶入</a></td>
                            </tr>
                        }
                        @if (balances.Items.Count == 0)
                        {
                            <tr><td colspan="7" class="muted">本倉沒有這個料號的結存。</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (balances.TotalCount > balances.Items.Count)
            {
                <p class="muted">本倉共 @balances.TotalCount 筆結存，只列前 @balances.Items.Count 筆；其他請至<a href="/Stock?WarehouseId=@d.WarehouseId" target="_blank" rel="noopener">庫存查詢</a>，再手動輸入儲位、批號、序號。</p>
            }
        }
        <form method="post" asp-page-handler="AddLine" id="document-line-form">
            <div class="form-grid">
                <label for="Line_LocationCode">@(isInbound ? "入庫儲位碼" : "來源儲位碼") <span class="required-mark">*</span></label>
                <input type="text" id="Line_LocationCode" name="Line.LocationCode" value="@Model.Line.LocationCode" required maxlength="200" placeholder="掃描儲位 QR 或輸入，例 W1-A-01" />
                <label for="Line_ItemCode">料號 <span class="required-mark">*</span></label>
                <input type="text" id="Line_ItemCode" name="Line.ItemCode" value="@Model.Line.ItemCode" required maxlength="200" placeholder="先用上方搜尋帶入，或直接輸入正式料號" />
                <label for="Line_Quantity">數量（基本單位） <span class="required-mark">*</span></label>
                <input type="number" id="Line_Quantity" name="Line.Quantity" value="@(Model.Line.Quantity == 0 ? "" : Display.Qty(Model.Line.Quantity))" min="0" step="any" required />
                <label for="Line_LotNo">批號</label>
                <input type="text" id="Line_LotNo" name="Line.LotNo" value="@Model.Line.LotNo" maxlength="@StockDocumentLine.CodeMaxLength" placeholder="批號管理的物料必填" />
                <label for="Line_SerialNo">序號</label>
                <input type="text" id="Line_SerialNo" name="Line.SerialNo" value="@Model.Line.SerialNo" maxlength="@StockDocumentLine.CodeMaxLength" placeholder="序號管理的物料：每個序號一行、數量 1" />
                @if (isInbound && Model.Settings.LineExpiryEnabled)
                {
                    <label for="Line_ExpiryDate">有效期限</label>
                    <input type="date" id="Line_ExpiryDate" name="Line.ExpiryDate" value="@(Model.Line.ExpiryDate?.ToString("yyyy-MM-dd"))" />
                }
                @if (isTransfer)
                {
                    @if (Model.Settings.LineCrossTransferEnabled)
                    {
                    <label for="Line_TargetWarehouseCode">目的倉庫碼</label>
                    <input type="text" id="Line_TargetWarehouseCode" name="Line.TargetWarehouseCode" value="@Model.Line.TargetWarehouseCode" maxlength="8" placeholder="空白＝同倉；掃別倉儲位 QR 時用 QR 上的倉庫" />
                    }
                    <label for="Line_TargetLocationCode">目的儲位碼 <span class="required-mark">*</span></label>
                    <input type="text" id="Line_TargetLocationCode" name="Line.TargetLocationCode" value="@Model.Line.TargetLocationCode" maxlength="200" placeholder="可掃別倉儲位 QR" />
                }
                @if (isOutbound && Model.Settings.LineReservationEnabled)
                {
                    <label for="Line_ReservationText">預留 ID</label>
                    <div>
                        <select id="Line_ReservationText" name="Line.ReservationText">
                            <option value="">（不指定）</option>
                            @foreach (var r in Model.ReservationOptions)
                            {
                                <option value="@r.Id" selected="@(r.Id.ToString() == Model.Line.ReservationText)">剩餘 @Display.Qty(r.RemainingQuantity)，@r.CreatedByName，@(r.ExpiresAt is { } ex ? "到期 " + Display.Time(ex) : "不到期")</option>
                            }
                        </select>
                        @if (Model.Resolved is null)
                        {
                            <div class="muted">先用上方搜尋帶入料號，才會列出該料號的手動預留。</div>
                        }
                    </div>
                }
            </div>
            <div class="actions"><button type="submit" id="document-add-line">加入明細</button></div>
        </form>
    </div>
}

<div class="doc-actions" id="document-actions">
    @if (Model.CanConfirm)
    {
        <form method="post" asp-page-handler="Confirm">
            <input type="hidden" name="Version" value="@Model.Version" />
            <input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey" />
            <button type="submit" id="document-confirm">確認過帳</button>
        </form>
    }
    @if (Model.CanSubmit)
    {
        <form method="post" asp-page-handler="Submit">
            <input type="hidden" name="Version" value="@Model.Version" />
            <input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey" />
            <button type="submit" id="document-submit">送審</button>
        </form>
    }
    @if (Model.CanApprove)
    {
        <form method="post" asp-page-handler="Approve">
            <input type="hidden" name="Version" value="@Model.Version" />
            <input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey" />
            <button type="submit" id="document-approve">核准並過帳</button>
        </form>
        <form method="post" asp-page-handler="Return">
            <input type="hidden" name="Version" value="@Model.Version" />
            <input type="text" name="Comment" maxlength="@StockDocument.NoteMaxLength" placeholder="退回原因（必填）" aria-label="退回原因" />
            <button type="submit" class="secondary" id="document-return">退回修改</button>
        </form>
    }
    @if (Model.CanCancel && Model.Doc.FromScanCart && Model.Doc.Status == Warehouse.Domain.Inventory.StockDocumentStatus.Draft)
    {
        @* 快速進出轉入的草稿：可直接刪除、不留單據（ADR-0026）；要先勾「確定刪除」才送得出去，避免誤按 *@
        <form method="post" asp-page-handler="DeleteScanCartDraft" id="scan-cart-draft-delete-form">
            <input type="hidden" name="Version" value="@Model.Version" />
            <label class="inline-check"><input type="checkbox" required id="scan-cart-draft-delete-confirm" /> 確定刪除（不留單據）</label>
            <button type="submit" class="danger" id="scan-cart-draft-delete">刪除這張草稿</button>
        </form>
    }
    @if (Model.CanCancel)
    {
        <form method="post" asp-page-handler="Cancel">
            <input type="hidden" name="Version" value="@Model.Version" />
            <button type="submit" class="danger" id="document-cancel">取消這張單</button>
        </form>
    }
    @if (Model.CanReverse)
    {
        <form method="post" asp-page-handler="Reverse">
            <button type="submit" class="secondary" id="document-reverse">建立沖銷單</button>
        </form>
    }
    <a href="/Documents/Print/@d.Id" target="_blank" rel="noopener" id="document-print">列印</a>
    @if (Model.CanConfirm)
    {
        <p class="muted hint">確認後立即過帳，已過帳的單據不能修改，更正只能建立沖銷單。</p>
    }
    @if (Model.CanSubmit)
    {
        <p class="muted hint">送審後明細不能修改（出倉單會同時預留庫存）；退回後可再修改。</p>
    }
    @if (Model.CanCancel)
    {
        <p class="muted hint">取消會作廢這張單並釋放預留，按下後立即生效。</p>
    }
</div>
@if (d.Status == StockDocumentStatus.Posted)
{
    <p><a href="/Stock?documentId=@d.Id">查看這張單產生的異動</a></p>
}

@* 關閉附件功能後，既有附件仍可檢視（唯讀），只是不能新增或移除（M6-05） *@
@if (s.DocumentAttachmentsEnabled || Model.Attachments.Count > 0)
{
    <h2>附件（@Model.Attachments.Count）</h2>
    @if (Model.Attachments.Count == 0)
    {
        <p class="muted" id="attachment-empty">沒有附件。</p>
    }
    <div class="attachment-grid" id="attachment-list">
        @foreach (var a in Model.Attachments)
        {
            <figure>
                @if (a.IsPdf)
                {
                    <a class="attachment-pdf" href="/files/document-attachments/@a.Id/file" target="_blank" rel="noopener">PDF</a>
                }
                else
                {
                    <a href="/files/document-attachments/@a.Id/file" target="_blank" rel="noopener">
                        <img src="/files/document-attachments/@a.Id/thumb" loading="lazy" alt="@a.FileName" width="160" />
                    </a>
                }
                <figcaption>
                    <a href="/files/document-attachments/@a.Id/file" target="_blank" rel="noopener">@a.FileName</a>
                    <span class="muted">@a.UploadedByName @Display.Time(a.UploadedAt)</span>
                    @if (Model.CanEdit && s.DocumentAttachmentsEnabled)
                    {
                        <form method="post" asp-page-handler="RemoveAttachment" class="inline">
                            <input type="hidden" name="attachmentId" value="@a.Id" />
                            <button type="submit" class="link">移除</button>
                        </form>
                    }
                </figcaption>
            </figure>
        }
    </div>
    @if (Model.CanUpload)
    {
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="panel filters" id="attachment-upload-form">
            <input type="file" name="Attachment" accept="image/jpeg,image/png,image/webp,application/pdf" aria-label="選擇附件" required />
            <button type="submit" id="attachment-upload">上傳</button>
            <span class="muted">JPEG／PNG／WebP／PDF，每檔 10 MB 以內，每張單最多 10 個；過帳後只能新增、不能移除。</span>
        </form>
    }
}
<p><a href="/Documents">回進出倉單清單</a></p>
@section Scripts {
    <script src="~/js/documents.js" asp-append-version="true"></script>
    @if (Model.CanEdit)
    {
        <script src="~/js/scan-input.js" asp-append-version="true"></script>
        <script src="~/js/picker.js" asp-append-version="true"></script>
        <script src="~/js/doc-scan.js" asp-append-version="true"></script>
    }
}
