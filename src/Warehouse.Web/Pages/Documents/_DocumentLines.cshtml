@model Warehouse.Web.Pages.Documents.DetailsModel
@using Warehouse.Domain.Inventory
@*
    明細表（M5-03 從 Details.cshtml 拆出）：整頁顯示與掃碼面板「加入明細」後的重繪共用同一份。
*@
@{
    var d = Model.Doc;
    var isTransfer = d.DocType == StockDocumentType.Transfer;
}
<div id="document-lines-section" data-scan-lines data-version="@Model.Version">
<h2>明細（@d.Lines.Count 行）</h2>
@if (Model.CanEdit && d.Lines.Count > 0)
{
    @* 勾選多行一次刪除（M8-03）：勾選框用 form 屬性掛到這個表單，每行原本的「刪除」表單不受影響 *@
    <form method="post" asp-page-handler="RemoveLines" id="lines-bulk-form" class="actions lines-bulk">
        <label><input type="checkbox" id="lines-select-all" /> 全選</label>
        <button type="submit" class="secondary" id="lines-remove-selected">刪除勾選的明細</button>
        <span class="muted" id="lines-selected-count"></span>
    </form>
}
<div class="table-wrap">
    <table id="document-lines">
        <thead>
            <tr>
                @if (Model.CanEdit)
                {
                    <th><span class="visually-hidden">勾選</span></th>
                }
                <th>#</th><th>儲位</th>
                @if (isTransfer)
                {
                    <th>→ 目的</th>
                }
                <th>料號</th><th>品名</th><th>批號</th><th>序號</th><th>有效期限</th><th>數量</th><th>單位</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in d.Lines)
            {
                <tr>
                    @if (Model.CanEdit)
                    {
                        <td><input type="checkbox" name="lineIds" value="@l.Id" form="lines-bulk-form" class="line-select" aria-label="勾選第 @l.LineNo 行" /></td>
                    }
                    <td>@l.LineNo</td>
                    <td>@l.LocationCode</td>
                    @if (isTransfer)
                    {
                        <td>@l.TargetWarehouseCode @l.TargetLocationCode</td>
                    }
                    <td>@l.ItemCode</td>
                    <td>
                        @l.ItemName
                        @if (l.ReservationId is { } reservationId)
                        {
                            <br /><span class="muted">預留 @reservationId</span>
                        }
                    </td>
                    <td>@l.LotNo</td>
                    <td>@l.SerialNo</td>
                    <td>@(l.ExpiryDate?.ToString("yyyy-MM-dd"))</td>
                    <td class="num">@Display.Qty(l.SignedQuantity)</td>
                    <td>@l.UnitCode</td>
                    <td>
                        @if (Model.CanEdit)
                        {
                            <form method="post" asp-page-handler="RemoveLine" class="inline">
                                <input type="hidden" name="lineId" value="@l.Id" />
                                <button type="submit" class="link">刪除</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (d.Lines.Count == 0)
            {
                <tr><td colspan="@((isTransfer ? 11 : 10) + (Model.CanEdit ? 1 : 0))" class="muted">尚無明細。</td></tr>
            }
        </tbody>
    </table>
</div>
</div>
