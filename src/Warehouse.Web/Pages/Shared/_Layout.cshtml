@using Warehouse.Application.Abstractions
@using Warehouse.Api.Authorization
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>@ViewData["Title"] - 倉庫管理系統</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav id="nav">
        <a id="nav-home" href="/">系統狀態</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a id="nav-search" href="/Search">搜尋</a>
            <a id="nav-items" href="/Items">物料</a>
            <a id="nav-warehouses" href="/Warehouses">倉庫</a>
            <a id="nav-stock" href="/Stock">庫存</a>
            <a id="nav-opening" href="/Opening">期初</a>
            <a id="nav-documents" href="/Documents">進出倉單</a>
            <a id="nav-reservations" href="/Reservations">預留</a>
            <a id="nav-anomalies" href="/Stock/Anomalies">庫存異常</a>
            @if (User.IsInRole(Roles.ItemManager))
            {
                <a id="nav-categories" href="/MasterData/Categories">分類</a>
                <a id="nav-units" href="/MasterData/Units">單位</a>
            }
            @if (User.IsInRole(Roles.ItemManager) || User.IsInRole(Roles.WarehouseManager))
            {
                <a id="nav-purposes" href="/MasterData/Purposes">用途類型</a>
                <a id="nav-partners" href="/MasterData/Partners">往來對象</a>
            }
            @if (User.IsInRole(Roles.SystemAdmin))
            {
                <a id="nav-settings" href="/Settings">設定</a>
            }
            <span class="nav-user">
                @(User.FindFirst(ActorClaims.DisplayName)?.Value ?? User.Identity.Name)
                <a href="/Account/ChangePassword">改密碼</a>
                <form method="post" asp-page="/Account/Logout" class="inline" id="logout-form">
                    <button type="submit" class="link">登出</button>
                </form>
            </span>
        }
        else
        {
            <a id="nav-login" href="/Account/Login">登入</a>
        }
    </nav>
    <main>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
