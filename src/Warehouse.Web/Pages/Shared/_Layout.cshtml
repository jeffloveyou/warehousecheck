@using Warehouse.Application.Abstractions
@using Warehouse.Api.Authorization
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" />
    @* PWA（M5-02）：可安裝到主畫面；Service Worker 只快取靜態檔（/sw.js，pwa.js） *@
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#243447" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="倉庫管理" />
    <title>@ViewData["Title"] - 倉庫管理系統</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-pwa-disabled="@(Configuration.GetValue<bool>("Pwa:Disabled") ? "true" : "false")">
    <nav id="nav">
        <a id="nav-home" href="/">系統狀態</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a id="nav-scan" href="/Scan">掃碼</a>
            @* 窄螢幕（手機）時其他連結收進「選單」，不需要 JS（checkbox＋CSS，Chrome 109 可用） *@
            <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="展開選單" />
            <label for="nav-toggle" class="nav-toggle-label">☰ 選單</label>
            <span class="nav-links">
            <a id="nav-search" href="/Search">搜尋</a>
            <a id="nav-items" href="/Items">物料</a>
            <a id="nav-warehouses" href="/Warehouses">倉庫</a>
            <a id="nav-stock" href="/Stock">庫存</a>
            <a id="nav-opening" href="/Opening">期初</a>
            <a id="nav-documents" href="/Documents">進出倉單</a>
            <a id="nav-stocktakes" href="/Stocktakes">盤點</a>
            <a id="nav-reservations" href="/Reservations">預留</a>
            <a id="nav-anomalies" href="/Stock/Anomalies">庫存異常</a>
            @if (User.IsInRole(Roles.ItemManager))
            {
                <a id="nav-categories" href="/MasterData/Categories">分類</a>
                <a id="nav-units" href="/MasterData/Units">單位</a>
            }
            @if (User.IsInRole(Roles.ItemManager) || User.IsInRole(Roles.WarehouseManager))
            {
                <a id="nav-purposes" href="/MasterData/Purposes">用途類型</a>
                <a id="nav-partners" href="/MasterData/Partners">往來對象</a>
            }
            @if (User.IsInRole(Roles.SystemAdmin))
            {
                <a id="nav-settings" href="/Settings">設定</a>
                <a id="nav-users" href="/Admin/Users">帳號</a>
                <a id="nav-audit" href="/Admin/Audit">操作日誌</a>
            }
            </span>
            <span class="nav-user">
                @(User.FindFirst(ActorClaims.DisplayName)?.Value ?? User.Identity.Name)
                <a href="/Account/ChangePassword">改密碼</a>
                <form method="post" asp-page="/Account/Logout" class="inline" id="logout-form">
                    <button type="submit" class="link">登出</button>
                </form>
            </span>
        }
        else
        {
            <a id="nav-login" href="/Account/Login">登入</a>
        }
    </nav>
    <div class="message error banner" id="offline-banner" role="alert" hidden>目前離線：畫面上的資料可能不是最新，送出不會成功。恢復連線後請重新整理。</div>
    <div class="message info banner" id="pwa-update" role="status" hidden>
        有新版本。<button type="button" id="pwa-update-button">完成目前作業後按這裡更新</button>
        <span id="pwa-update-note"></span>
    </div>
    <main>
        @RenderBody()
    </main>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
