@page
@model Warehouse.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "系統設定";
}
<h1>系統設定</h1>
<p class="muted">所有功能開關集中在這裡。<strong>關閉功能只會隱藏輸入欄位、停止檢查，既有資料一律保留</strong>，在詳情、列印與操作日誌中仍可查看；重新開啟就能繼續使用。每次變更都會記錄在操作日誌（下方「最近變更」）。</p>
@if (TempData["Message"] is string message)
{
    <div class="message info">@message</div>
}
@if (Model.Error is not null)
{
    <div class="message error" id="page-error">@Model.Error 畫面已顯示目前的設定。</div>
}
<form method="post" class="panel" id="settings-form">
    @* 開頁時的值：只更新使用者實際改動的項目 *@
    <input type="hidden" name="Original.AllowSelfApproveOpening" value="@Model.Original.AllowSelfApproveOpening.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.LocationNotesEnabled" value="@Model.Original.LocationNotesEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.LocationAttributesEnabled" value="@Model.Original.LocationAttributesEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.LocationImagesEnabled" value="@Model.Original.LocationImagesEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.DocumentApprovalEnabled" value="@Model.Original.DocumentApprovalEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.AllowSelfApproveDocuments" value="@Model.Original.AllowSelfApproveDocuments.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.DocumentPurposeEnabled" value="@Model.Original.DocumentPurposeEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.DocumentPurposeRequired" value="@Model.Original.DocumentPurposeRequired.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.DocumentPartnerEnabled" value="@Model.Original.DocumentPartnerEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.DocumentPartnerRequired" value="@Model.Original.DocumentPartnerRequired.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.DocumentExternalNoEnabled" value="@Model.Original.DocumentExternalNoEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.DocumentExternalNoRequired" value="@Model.Original.DocumentExternalNoRequired.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.DocumentNoteEnabled" value="@Model.Original.DocumentNoteEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.DocumentNoteRequired" value="@Model.Original.DocumentNoteRequired.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.DocumentAttachmentsEnabled" value="@Model.Original.DocumentAttachmentsEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.PrintCompanyName" value="@Model.Original.PrintCompanyName" />
    <input type="hidden" name="Original.AllowSelfApproveStocktake" value="@Model.Original.AllowSelfApproveStocktake.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.StocktakeBlindCount" value="@Model.Original.StocktakeBlindCount.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.LineExpiryEnabled" value="@Model.Original.LineExpiryEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.LineReservationEnabled" value="@Model.Original.LineReservationEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.LineCrossTransferEnabled" value="@Model.Original.LineCrossTransferEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.LineLotSerialEnabled" value="@Model.Original.LineLotSerialEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.AllowItemUnitTrackingChangeWithActivity" value="@Model.Original.AllowItemUnitTrackingChangeWithActivity.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Original.RememberMeDays" value="@Model.Original.RememberMeDays" />
    <input type="hidden" name="Original.RetentionAuditYears" value="@Model.Original.RetentionAuditYears" />
    <input type="hidden" name="Original.RetentionLoginDays" value="@Model.Original.RetentionLoginDays" />
    <input type="hidden" name="Original.RetentionProcessedCommandsDays" value="@Model.Original.RetentionProcessedCommandsDays" />
    <input type="hidden" name="Original.RetentionPostingFailuresDays" value="@Model.Original.RetentionPostingFailuresDays" />
    <input type="hidden" name="Original.RetentionImportBatchesDays" value="@Model.Original.RetentionImportBatchesDays" />
    <h2>登入</h2>
    <div class="form-grid">
        <label for="Form_RememberMeDays">「記住我」保持登入（天，0＝不提供）</label>
        <input type="number" id="Form_RememberMeDays" name="Form.RememberMeDays" value="@Model.Form.RememberMeDays"
               min="@Warehouse.Application.Settings.AuthLimits.RememberMeDaysMin" max="@Warehouse.Application.Settings.AuthLimits.RememberMeDaysMax" required />
    </div>
    <p class="muted">預設 14 天。登入時勾選「記住我」，關掉瀏覽器也不必重新登入；每次使用會自動延長，連續這麼多天沒用才要重新登入。帳號停用、改角色、重設密碼後最慢 5 分鐘失效。<strong>公用電腦不要勾選</strong>，用完請按「登出」。改天數只影響之後的登入。</p>
    <h2>物料</h2>
    <p><label><input type="checkbox" name="Form.AllowItemUnitTrackingChangeWithActivity" value="true" checked="@Model.Form.AllowItemUnitTrackingChangeWithActivity" id="setting-item-unit-change" /> 已有異動紀錄的物料，也可以修改基本單位、追蹤模式</label></p>
    <p class="muted">預設關閉：物料一旦進出過庫存，基本單位與追蹤模式就鎖住（ADR-0023）。開啟後由物料管理員在修改畫面勾選確認並填寫原因才能改，<strong>舊紀錄的數量不會換算</strong>（例如原本 10 個，改成「箱」後會顯示 10 箱）。即使開啟，有未完成單據、有效預留、進行中盤點時仍不能改；改追蹤模式時結存必須全部為 0。</p>
    <h2>期初建帳</h2>
    <p><label><input type="checkbox" name="Form.AllowSelfApproveOpening" value="true" checked="@Model.Form.AllowSelfApproveOpening" /> 允許建立者核准自己的期初單</label></p>
    <p class="muted">預設不允許（ADR-0003 D-07）。不論哪一種，都會記錄建立者、核准者與時間。</p>
    <h2>盤點</h2>
    <p><label><input type="checkbox" name="Form.StocktakeBlindCount" value="true" checked="@Model.Form.StocktakeBlindCount" /> 盲盤：輸入實盤量時不顯示帳面量</label></p>
    <p class="muted">預設開啟。只影響盤點畫面、盤點表與盤點匯出：作業員盤點中看不到帳面量，倉庫主管與送審後才看得到；庫存查詢頁本來就顯示結存，不受這個設定影響。</p>
    <p><label><input type="checkbox" name="Form.AllowSelfApproveStocktake" value="true" checked="@Model.Form.AllowSelfApproveStocktake" /> 允許盤點單的建立者或送審者自己核准盤差</label></p>
    <p class="muted">預設不允許（D-07）。不論哪一種，都會記錄建立者、送審者、核准者與時間。</p>
    <h2>倉位註記</h2>
    <p><label><input type="checkbox" name="Form.LocationNotesEnabled" value="true" checked="@Model.Form.LocationNotesEnabled" /> 自由備註</label></p>
    <p><label><input type="checkbox" name="Form.LocationAttributesEnabled" value="true" checked="@Model.Form.LocationAttributesEnabled" /> 結構化屬性（區／架／層／格、類型、承重、溫控、危險品）</label></p>
    <p><label><input type="checkbox" name="Form.LocationImagesEnabled" value="true" checked="@Model.Form.LocationImagesEnabled" /> 倉位圖片</label></p>
    <p class="muted">關閉只會隱藏畫面上的欄位，已填的資料會保留，重新開啟就能看到。每次變更都會留下稽核紀錄。</p>
    <h2>進出倉單</h2>
    <p><label><input type="checkbox" name="Form.DocumentApprovalEnabled" value="true" checked="@Model.Form.DocumentApprovalEnabled" /> 單據需要審核（草稿 → 送審 → 倉庫主管核准才過帳）</label></p>
    <p class="muted">關閉時（預設）：草稿確認即過帳。開啟後出倉單送審時會預留庫存。已在待核准的單據不受影響。</p>
    <p><label><input type="checkbox" name="Form.AllowSelfApproveDocuments" value="true" checked="@Model.Form.AllowSelfApproveDocuments" /> 允許建立者核准自己的進出倉單</label></p>
    <p class="muted">預設不允許；與期初單的自核設定分開。不論哪一種，都會記錄建立者、核准者與時間。</p>
    <h3>明細輸入欄位</h3>
    <p><label><input type="checkbox" name="Form.LineLotSerialEnabled" value="true" checked="@Model.Form.LineLotSerialEnabled" /> 批號、序號欄</label></p>
    <p><label><input type="checkbox" name="Form.LineExpiryEnabled" value="true" checked="@Model.Form.LineExpiryEnabled" /> 有效期限（進倉、期初）</label></p>
    <p><label><input type="checkbox" name="Form.LineReservationEnabled" value="true" checked="@Model.Form.LineReservationEnabled" /> 出倉指定預留</label></p>
    <p><label><input type="checkbox" name="Form.LineCrossTransferEnabled" value="true" checked="@Model.Form.LineCrossTransferEnabled" /> 跨倉移庫（目的儲位可在其他倉庫）</label></p>
    <p class="muted">關閉的欄位在明細輸入區不顯示，所有人都一樣；每個人還可以在輸入區的「欄位」選單再隱藏自己用不到的欄位。料號本身是批號或序號管理時，批號、序號欄一律顯示並必填。</p>
    <div class="table-wrap">
        <table id="document-field-settings">
            <thead><tr><th>表頭欄位</th><th>啟用</th><th>必填（確認或送審時檢查）</th></tr></thead>
            <tbody>
                <tr>
                    <td>用途（移庫不適用）</td>
                    <td><input type="checkbox" name="Form.DocumentPurposeEnabled" value="true" checked="@Model.Form.DocumentPurposeEnabled" aria-label="用途啟用" /></td>
                    <td><input type="checkbox" name="Form.DocumentPurposeRequired" value="true" checked="@Model.Form.DocumentPurposeRequired" aria-label="用途必填" /></td>
                </tr>
                <tr>
                    <td>往來對象</td>
                    <td><input type="checkbox" name="Form.DocumentPartnerEnabled" value="true" checked="@Model.Form.DocumentPartnerEnabled" aria-label="往來對象啟用" /></td>
                    <td><input type="checkbox" name="Form.DocumentPartnerRequired" value="true" checked="@Model.Form.DocumentPartnerRequired" aria-label="往來對象必填" /></td>
                </tr>
                <tr>
                    <td>外部單號</td>
                    <td><input type="checkbox" name="Form.DocumentExternalNoEnabled" value="true" checked="@Model.Form.DocumentExternalNoEnabled" aria-label="外部單號啟用" /></td>
                    <td><input type="checkbox" name="Form.DocumentExternalNoRequired" value="true" checked="@Model.Form.DocumentExternalNoRequired" aria-label="外部單號必填" /></td>
                </tr>
                <tr>
                    <td>備註</td>
                    <td><input type="checkbox" name="Form.DocumentNoteEnabled" value="true" checked="@Model.Form.DocumentNoteEnabled" aria-label="備註啟用" /></td>
                    <td><input type="checkbox" name="Form.DocumentNoteRequired" value="true" checked="@Model.Form.DocumentNoteRequired" aria-label="備註必填" /></td>
                </tr>
            </tbody>
        </table>
    </div>
    <p class="muted">關閉欄位只隱藏畫面並略過檢查，已填的資料保留。</p>
    <p><label><input type="checkbox" name="Form.DocumentAttachmentsEnabled" value="true" checked="@Model.Form.DocumentAttachmentsEnabled" /> 單據附件（照片、掃描檔）</label></p>
    <div class="form-grid">
        <label for="Form_PrintCompanyName">列印公司名稱</label>
        <input type="text" id="Form_PrintCompanyName" name="Form.PrintCompanyName" value="@Model.Form.PrintCompanyName" maxlength="100" placeholder="空白＝列印時不印抬頭" />
    </div>
    <h2>資料保留</h2>
    <p class="muted">每天清除超過期限的紀錄。<strong>庫存單據、異動、結存、物料不會被清除</strong>。下限是規定（操作日誌 7 年、登入紀錄 1 年），低於下限無法儲存。</p>
    <div class="form-grid" id="retention-settings">
        <label for="Form_RetentionAuditYears">操作日誌（年，至少 @Warehouse.Application.Settings.RetentionLimits.AuditYearsMin）</label>
        <input type="number" id="Form_RetentionAuditYears" name="Form.RetentionAuditYears" value="@Model.Form.RetentionAuditYears" min="@Warehouse.Application.Settings.RetentionLimits.AuditYearsMin" max="@Warehouse.Application.Settings.RetentionLimits.YearsMax" required />
        <label for="Form_RetentionLoginDays">登入紀錄（天，至少 @Warehouse.Application.Settings.RetentionLimits.LoginDaysMin）</label>
        <input type="number" id="Form_RetentionLoginDays" name="Form.RetentionLoginDays" value="@Model.Form.RetentionLoginDays" min="@Warehouse.Application.Settings.RetentionLimits.LoginDaysMin" max="@Warehouse.Application.Settings.RetentionLimits.DaysMax" required />
        <label for="Form_RetentionProcessedCommandsDays">防重複送出紀錄（天，至少 @Warehouse.Application.Settings.RetentionLimits.ProcessedCommandsDaysMin）</label>
        <input type="number" id="Form_RetentionProcessedCommandsDays" name="Form.RetentionProcessedCommandsDays" value="@Model.Form.RetentionProcessedCommandsDays" min="@Warehouse.Application.Settings.RetentionLimits.ProcessedCommandsDaysMin" max="@Warehouse.Application.Settings.RetentionLimits.DaysMax" required />
        <label for="Form_RetentionPostingFailuresDays">過帳失敗紀錄（天，至少 @Warehouse.Application.Settings.RetentionLimits.PostingFailuresDaysMin）</label>
        <input type="number" id="Form_RetentionPostingFailuresDays" name="Form.RetentionPostingFailuresDays" value="@Model.Form.RetentionPostingFailuresDays" min="@Warehouse.Application.Settings.RetentionLimits.PostingFailuresDaysMin" max="@Warehouse.Application.Settings.RetentionLimits.DaysMax" required />
        <label for="Form_RetentionImportBatchesDays">匯入批次（天，至少 @Warehouse.Application.Settings.RetentionLimits.ImportBatchesDaysMin）</label>
        <input type="number" id="Form_RetentionImportBatchesDays" name="Form.RetentionImportBatchesDays" value="@Model.Form.RetentionImportBatchesDays" min="@Warehouse.Application.Settings.RetentionLimits.ImportBatchesDaysMin" max="@Warehouse.Application.Settings.RetentionLimits.DaysMax" required />
    </div>
    <div class="actions"><button type="submit" id="settings-save">儲存</button></div>
</form>
<h2>最近變更</h2>
<div class="table-wrap">
    <table id="setting-changes">
        <thead><tr><th>時間</th><th>變更者</th><th>設定</th><th>變更前</th><th>變更後</th></tr></thead>
        <tbody>
            @foreach (var c in Model.RecentChanges)
            {
                <tr>
                    <td>@Display.Time(c.OccurredAt)</td>
                    <td>@c.ActorName</td>
                    <td>@Warehouse.Web.Pages.Settings.IndexModel.LabelOf(c.EntityId)</td>
                    <td><code class="json">@c.Before</code></td>
                    <td><code class="json">@c.After</code></td>
                </tr>
            }
            @if (Model.RecentChanges.Count == 0)
            {
                <tr><td colspan="5" class="muted">最近 90 天沒有變更。</td></tr>
            }
        </tbody>
    </table>
</div>
<p><a href="/Admin/Audit?ActionPrefix=setting.">在操作日誌查看全部設定變更</a></p>
