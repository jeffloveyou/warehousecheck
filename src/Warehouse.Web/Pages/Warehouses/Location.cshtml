@page "{id:guid}"
@model Warehouse.Web.Pages.Warehouses.LocationModel
@using Warehouse.Domain.Warehousing
@{
    var l = Model.Location;
    ViewData["Title"] = $"{l.WarehouseCode} {l.Code}";
}
<h1>@l.WarehouseCode／@l.Code <span class="location-@l.Status">@Display.Of(l.Status)</span></h1>
@if (TempData["Message"] is string message)
{
    <div class="message info" id="page-message">@message</div>
}
@if (Model.Error is not null)
{
    <div class="message error" id="page-error">@Model.Error</div>
}
<dl class="status">
    <dt>名稱</dt><dd>@l.Name</dd>
    <dt>QR 內容</dt><dd><code id="qr-content">@l.QrContent</code> <span class="muted">（V1 不列印標籤；可用此文字自製 QR Code）</span></dd>
    @* 關閉註記功能後，已填的資料仍顯示（唯讀，M6-05） *@
    @if (Model.Settings.LocationNotesEnabled || l.Note is not null)
    {
        <dt>備註</dt><dd style="white-space: pre-line">@l.Note</dd>
    }
    @if (Model.Settings.LocationAttributesEnabled || l.Zone is not null || l.Rack is not null || l.Level is not null || l.Bin is not null
         || l.LocationType is not null || l.MaxLoadKg is not null || l.TemperatureControlled || l.Hazardous)
    {
        <dt>區／架／層／格</dt><dd>@string.Join(" / ", new[] { l.Zone, l.Rack, l.Level, l.Bin }.Where(s => s is not null))</dd>
        <dt>類型</dt><dd>@(l.LocationType is { } t ? Display.Of(t) : "")</dd>
        <dt>承重上限</dt><dd>@(l.MaxLoadKg is { } kg ? $"{kg:0.##} kg" : "")</dd>
        <dt>溫控／危險品</dt><dd>@(l.TemperatureControlled ? "溫控" : "－")／@(l.Hazardous ? "危險品" : "－")</dd>
    }
    <dt>更新</dt><dd>@Display.Time(l.UpdatedAt)</dd>
</dl>
<p><a href="/Warehouses/Locations?warehouseId=@l.WarehouseId">回儲位清單</a></p>

@if (Model.Settings.LocationImagesEnabled || Model.Images.Count > 0)
{
    <h2>圖片</h2>
    <div class="image-grid" id="location-images">
        @foreach (var image in Model.Images)
        {
            <figure>
                <a href="/files/location-images/@image.Id/large" target="_blank" rel="noopener">
                    @* 延遲載入：捲動到附近才下載；寬高先給，版面不會跳動 *@
                    <img src="/files/location-images/@image.Id/thumb" loading="lazy" alt="儲位圖片" width="160"
                         height="@(Math.Max(1, image.Height * 160 / Math.Max(1, image.Width)))" />
                </a>
                <figcaption class="muted">@image.UploadedByName @Display.Time(image.UploadedAt)
                    @if (Model.CanManage && Model.Settings.LocationImagesEnabled)
                    {
                        <form method="post" asp-page-handler="DeactivateImage" class="inline">
                            <input type="hidden" name="imageId" value="@image.Id" />
                            <button type="submit" class="link">停用</button>
                        </form>
                    }
                </figcaption>
            </figure>
        }
        @if (Model.Images.Count == 0)
        {
            <p class="muted">尚無圖片。</p>
        }
    </div>
    @if (Model.CanManage && Model.Settings.LocationImagesEnabled)
    {
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="panel filters" id="image-upload-form">
            <input type="file" name="Photo" accept="image/jpeg,image/png,image/webp" aria-label="選擇圖片" required />
            <button type="submit" id="image-upload">上傳</button>
            <span class="muted">JPEG／PNG／WebP，10 MB 以內；系統會自動縮圖，每個儲位最多 10 張。</span>
        </form>
    }
}

@if (Model.CanManage)
{
    <form method="post" asp-page-handler="Update" class="panel" id="location-edit-form">
        <h2>修改</h2>
        <input type="hidden" name="Version" id="edit-version" value="@Model.Version" />
        <partial name="_LocationFields" model="(Model.Form, Model.Settings, false)" />
        <div class="actions"><button type="submit" id="location-save">儲存</button></div>
    </form>
    <form method="post" asp-page-handler="Status" class="panel filters" id="location-status-form">
        <input type="hidden" name="Version" id="status-version" value="@Model.Version" />
        <label for="NewStatus">變更狀態</label>
        <select id="NewStatus" name="NewStatus">
            @foreach (var status in Enum.GetValues<LocationStatus>().Where(s => s != l.Status))
            {
                <option value="@status">@Display.Of(status)</option>
            }
        </select>
        <button type="submit" class="secondary" id="location-status">變更</button>
        <span class="muted">待驗：可存放但不算可用量；停用：不能過帳。</span>
    </form>
}
