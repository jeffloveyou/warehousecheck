@page
@model Warehouse.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "改密碼";
}
<h1>改密碼</h1>
@if (Model.MustChange)
{
    <div class="message warn">這是初始或重設後的密碼，請先設定自己的新密碼才能繼續使用。</div>
}
<form method="post" id="change-password-form">
    <div asp-validation-summary="ModelOnly" class="field-error"></div>
    <div class="form-grid">
        <label asp-for="Input.CurrentPassword"></label>
        <div>
            <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
        </div>
        <label asp-for="Input.NewPassword"></label>
        <div>
            <input asp-for="Input.NewPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="field-error"></span>
        </div>
        <label asp-for="Input.ConfirmPassword"></label>
        <div>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
        <span></span>
        <div><button type="submit" id="change-password-submit">變更密碼</button></div>
    </div>
</form>
<p class="muted">密碼至少 8 個字元，且至少包含 4 種不同字元。</p>
