@page "{id:guid}"
@model Warehouse.Web.Pages.Quick.ConvertModel
@using Warehouse.Domain.Inventory
@{
    var c = Model.Cart;
    var isTransfer = Model.Type == StockDocumentType.Transfer;
    var isInbound = Model.Type == StockDocumentType.Inbound;
    var lockedWarehouseId = Model.LockedWarehouseId;
    var lockedWarehouse = Model.WarehouseOptions.FirstOrDefault(w => w.Id == lockedWarehouseId);
    var cartLines = c.Lines.ToDictionary(l => l.Id);
    var linePrefix = Model.ExpectedVersion is null ? "Lines" : "PreparedLines";
    ViewData["Title"] = "快速" + Model.TypeName;
}
<p><a href="/Quick/Cart/@c.Id">← 回購物車</a></p>
<h1>快速@(Model.TypeName)：@Warehouse.Web.Pages.Quick.IndexModel.Name(c.CreatedAt, c.Note)</h1>
<p class="muted">補齊每行的@(isInbound ? "進倉" : "來源")儲位@(isTransfer ? "與目的儲位" : "")後按「產生草稿」，到單據頁核對、確認過帳。儲位選單中有這個料的儲位排前面，數量少的最前面。</p>
@if (Model.Error is not null)
{
    <div class="message error" id="page-error">@Model.Error</div>
}
@if (Model.CanSubmit || Model.Lines.Count > 0)
{
<form method="post" asp-page="/Quick/Convert" asp-page-handler="" asp-route-id="@c.Id" class="panel" id="quick-convert-form"
      data-locations-url="@Model.LocationsUrl" data-lots-url="@(isInbound ? "" : Model.LotsUrl)"
      data-unsaved="@((Model.CanSubmit && Model.Error is not null).ToString().ToLowerInvariant())">
    <input type="hidden" name="Type" value="@Model.Type" />
    <input type="hidden" name="RequestId" value="@Model.RequestId" />
    @if (Model.ExpectedVersion is { } expectedVersion)
    {
        <input type="hidden" name="ExpectedVersion" value="@expectedVersion" />
    }
    @if (Model.PreparedWarehouseId is { } preparedWarehouse)
    {
        <input type="hidden" name="PreparedWarehouseId" value="@preparedWarehouse" />
    }
    <fieldset disabled="@(!Model.CanSubmit)">
    <div class="form-grid">
        <label for="quick-warehouse">倉庫 <span class="required-mark">*</span></label>
        @if (lockedWarehouseId is not null)
        {
            <div>
                <input type="hidden" name="WarehouseId" value="@lockedWarehouseId" id="quick-warehouse" />
                <strong>@(lockedWarehouse?.Code ?? c.WarehouseCode)</strong> <span class="muted">（本批明細使用的倉庫）</span>
            </div>
        }
        else
        {
            <select id="quick-warehouse" name="WarehouseId" required>
                <option value="">選擇倉庫</option>
                @foreach (var w in Model.WarehouseOptions)
                {
                    <option value="@w.Id" selected="@(w.Id == Model.WarehouseId)">@w.Code @w.Name</option>
                }
            </select>
        }
        @if (!isTransfer && Model.Settings.DocumentPurposeEnabled)
        {
            <label for="quick-purpose">用途 @if (Model.Settings.DocumentPurposeRequired) { <span class="required-mark">*</span> }</label>
            <select id="quick-purpose" name="PurposeId">
                <option value="">（不指定）</option>
                @foreach (var p in Model.Purposes)
                {
                    <option value="@p.Id" selected="@(p.Id == Model.PurposeId)">@p.Code @p.Name</option>
                }
            </select>
        }
        @if (Model.Settings.DocumentNoteEnabled)
        {
            <label for="quick-convert-note">備註</label>
            <input type="hidden" name="HasDocumentNote" value="true" />
            <input type="text" id="quick-convert-note" name="Note" value="@Model.Note" maxlength="@StockDocument.NoteMaxLength" />
        }
    </div>

    <div class="table-wrap">
        <table id="quick-convert-lines">
            <thead>
                <tr>
                    <th>#</th><th>物料</th><th>數量</th><th>@(isInbound ? "進倉儲位" : "來源儲位")</th>
                    @if (isTransfer)
                    {
                        @if (Model.Settings.LineCrossTransferEnabled) { <th>目的倉庫</th> }
                        <th>目的儲位</th>
                    }
                    <th>批號／序號</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    var form = Model.Lines[i];
                    var field = $"{linePrefix}[{i}]";
                    if (!cartLines.TryGetValue(form.LineId, out var l))
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>購物車中已無此筆明細</td>
                            <td class="num">@form.Quantity</td>
                            <td>@form.LocationCode</td>
                            @if (isTransfer)
                            {
                                @if (Model.Settings.LineCrossTransferEnabled) { <td>@form.TargetWarehouseCode</td> }
                                <td>@form.TargetLocationCode</td>
                            }
                            <td>@form.LotNo @form.SerialNos</td>
                        </tr>
                        continue;
                    }
                    var quantity = form.Quantity ?? l.Quantity;
                    <tr data-item-id="@l.ItemId">
                        <td>
                            @(i + 1)<input type="hidden" name="@(field + ".LineId")" value="@l.Id" />
                            @if (form.Quantity is not null)
                            {
                                <input type="hidden" name="@(field + ".Quantity")" value="@form.Quantity" />
                            }
                        </td>
                        <td>@l.ItemCode @l.ItemName<span class="muted">@(l.ItemActive ? "" : "（已停用）")</span></td>
                        <td class="num">@Display.Qty(quantity) @l.UnitCode</td>
                        <td>
                            <input type="text" name="@(field + ".LocationCode")" value="@form.LocationCode" class="quick-location" data-item-id="@l.ItemId"
                                   autocomplete="off" required maxlength="200" placeholder="點選或輸入儲位" aria-label="第 @l.LineNo 行儲位" />
                        </td>
                        @if (isTransfer)
                        {
                            @if (Model.Settings.LineCrossTransferEnabled)
                            {
                                <td>
                                    <select name="@(field + ".TargetWarehouseCode")" class="quick-target-warehouse" aria-label="第 @l.LineNo 行目的倉庫">
                                        <option value="">（同倉）</option>
                                        @foreach (var w in Model.WarehouseOptions)
                                        {
                                            <option value="@w.Code" selected="@(w.Code == form.TargetWarehouseCode)">@w.Code @w.Name</option>
                                        }
                                    </select>
                                </td>
                            }
                            <td>
                                <input type="text" name="@(field + ".TargetLocationCode")" value="@form.TargetLocationCode" class="quick-target" autocomplete="off" required
                                       maxlength="200" placeholder="點選或輸入目的儲位" aria-label="第 @l.LineNo 行目的儲位" />
                            </td>
                        }
                        <td>
                            @if (l.TrackingMode == Warehouse.Domain.Items.TrackingMode.Lot)
                            {
                                <input type="text" name="@(field + ".LotNo")" value="@form.LotNo" class="quick-lot" data-item-id="@l.ItemId" autocomplete="off" required
                                       maxlength="50" placeholder="批號" aria-label="第 @l.LineNo 行批號" />
                                @if (isInbound && Model.Settings.LineExpiryEnabled)
                                {
                                    <input type="date" name="@(field + ".ExpiryDate")" value="@(form.ExpiryDate?.ToString("yyyy-MM-dd"))" aria-label="第 @l.LineNo 行有效期限" />
                                }
                            }
                            else if (l.TrackingMode == Warehouse.Domain.Items.TrackingMode.Serial)
                            {
                                <textarea name="@(field + ".SerialNos")" rows="2" class="quick-serials" data-item-id="@l.ItemId" required
                                          placeholder="序號，一行一個（共 @Display.Qty(l.Quantity) 個）" aria-label="第 @l.LineNo 行序號">@form.SerialNos</textarea>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.CanSubmit)
    {
        <div class="actions"><button type="submit" id="quick-convert">產生@(Model.TypeName)草稿</button></div>
    }
    </fieldset>
</form>
}

@section Scripts {
    <script src="~/js/picker.js" asp-append-version="true"></script>
    <script src="~/js/quick-convert.js" asp-append-version="true"></script>
}
