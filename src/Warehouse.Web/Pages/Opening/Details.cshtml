@page "{id:guid}"
@model Warehouse.Web.Pages.Opening.DetailsModel
@using Warehouse.Domain.Inventory
@using Warehouse.Application.Warehousing
@{
    var d = Model.Doc;
    ViewData["Title"] = d.DocNo;
    ViewData["UsesPrefs"] = true; // 明細輸入區的常用設定（M8-06）
}
<h1>@d.DocNo <span class="muted">@d.WarehouseCode</span> @Display.Of(d.Status)</h1>
@if (TempData["Message"] is string message)
{
    <div class="message info" id="page-message">@message</div>
}
@if (Model.Error is not null)
{
    <div class="message error" id="page-error">@Model.Error</div>
}
@if (d.ReturnComment is not null && d.Status == StockDocumentStatus.Draft)
{
    <div class="message warn">退回原因：@d.ReturnComment</div>
}
<dl class="status">
    <dt>備註</dt><dd>@d.Note</dd>
    <dt>建立</dt><dd>@d.CreatedByName @Display.Time(d.CreatedAt)</dd>
    <dt>送出</dt><dd>@(d.SubmittedAt is { } s ? Display.Time(s) : "")</dd>
    <dt>核准過帳</dt><dd>@d.ApprovedByName @(d.PostedAt is { } p ? Display.Time(p) : "")</dd>
</dl>

@* 掃碼面板放在明細表上面：明細很多時（尤其手機）不必捲到最下面才能掃 *@
@if (Model.CanEdit)
{
    <partial name="_ScanPanel" model="Model.ScanPanel" />
}
@if (Model.CanEdit)
{
    <p><a href="/Import?Kind=OpeningLines&Target=@Model.Doc.Id" id="opening-import-link">從 Excel 匯入明細</a></p>
}
<partial name="_OpeningLines" model="Model" />

@if (Model.CanEdit)
{
    <form method="post" asp-page-handler="AddLine" class="panel" id="opening-line-form">
        <h2>新增明細（手動輸入、確認空儲位）</h2>
        <div class="form-grid">
            <label for="Line_LocationCode">儲位碼 *</label>
            <input type="text" id="Line_LocationCode" name="Line.LocationCode" value="@Model.Line.LocationCode" required maxlength="200" placeholder="掃描儲位 QR 或輸入，例 W1-A-01" />
            <label for="Line_ItemCode">料號</label>
            <div>
                <input type="text" id="Line_ItemCode" name="Line.ItemCode" value="@Model.Line.ItemCode" maxlength="200" placeholder="例 EL-000125，或掃物料 QR、單件條碼" />
                <a href="/Search" target="_blank" rel="noopener">查料號</a>
            </div>
            <label for="Line_Quantity">數量（基本單位）</label>
            <input type="number" id="Line_Quantity" name="Line.Quantity" value="@Model.Line.Quantity" min="0" step="any" />
            <label for="Line_LotNo">批號</label>
            <input type="text" id="Line_LotNo" name="Line.LotNo" value="@Model.Line.LotNo" maxlength="@StockDocumentLine.CodeMaxLength" placeholder="批號管理的物料必填" />
            @if (Model.LineSettings.LineExpiryEnabled)
            {
                <label for="Line_ExpiryDate">有效期限</label>
            <input type="date" id="Line_ExpiryDate" name="Line.ExpiryDate" value="@(Model.Line.ExpiryDate?.ToString("yyyy-MM-dd"))" />
            }
            <label for="Line_SerialNo">序號</label>
            <input type="text" id="Line_SerialNo" name="Line.SerialNo" value="@Model.Line.SerialNo" maxlength="@StockDocumentLine.CodeMaxLength" placeholder="序號管理的物料：每個序號一行、數量 1" />
            <span></span>
            <label><input type="checkbox" name="Line.EmptyLocation" value="true" checked="@Model.Line.EmptyLocation" /> 這個儲位確認為空（不填物料）</label>
        </div>
        <div class="actions"><button type="submit" id="opening-add-line">加入</button></div>
    </form>
    <form method="get" class="filters" id="suggest-form">
        <input type="text" name="Suggest" value="@Model.Suggest" maxlength="200" placeholder="料號（可掃碼）" aria-label="查建議儲位的料號" data-scan-field data-camera-field="item" autocomplete="off" />
        <button type="submit" class="secondary" id="suggest-submit">查建議儲位</button>
        @if (Model.Suggestions is { } suggestions)
        {
            <span id="suggestions">
                @if (suggestions.Count == 0)
                {
                    <span class="muted">沒有建議（尚未設定常用倉位、也沒有庫存）。</span>
                }
                @foreach (var s in suggestions)
                {
                    <span class="chip">@s.LocationCode（@(s.Reason switch { SuggestionReason.Default => "預設", SuggestionReason.Frequent => "常用", _ => "有庫存" })@(s.QuantityHere > 0 ? $"，現有 {Display.Qty(s.QuantityHere)}" : "")）</span>
                }
            </span>
        }
    </form>
    @if (Model.Uncounted.Count > 0)
    {
        <p class="muted">尚未清點的儲位（前 @Model.Uncounted.Count 個）：@string.Join("、", Model.Uncounted.Select(u => u.LocationCode))</p>
    }
    <div class="actions">
        <form method="post" asp-page-handler="Submit" class="inline">
            <input type="hidden" name="Version" value="@Model.Version" />
            <button type="submit" id="opening-submit">送出核准</button>
        </form>
        <form method="post" asp-page-handler="Cancel" class="inline">
            <input type="hidden" name="Version" value="@Model.Version" />
            <button type="submit" class="secondary" id="opening-cancel">取消這張單</button>
        </form>
    </div>
}

@if (Model.CanApprove)
{
    <form method="post" class="panel" id="opening-review-form">
        <h2>核准</h2>
        <p class="muted">核准後立即過帳：產生結存與異動紀錄，這些儲位標記為已清點，之後不能再做期初。</p>
        <input type="hidden" name="Version" value="@Model.Version" />
        <input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey" />
        <p><label for="Comment">退回原因</label><textarea id="Comment" name="Comment" maxlength="@StockDocument.NoteMaxLength"></textarea></p>
        <div class="actions">
            <button type="submit" asp-page-handler="Approve" id="opening-approve">核准並過帳</button>
            <button type="submit" asp-page-handler="Return" class="secondary" id="opening-return">退回修改</button>
        </div>
    </form>
}
@if (d.Status == StockDocumentStatus.Posted)
{
    <p><a href="/Stock?documentId=@d.Id">查看這張單產生的異動</a></p>
}
<p><a href="/Opening">回期初單清單</a></p>
@section Scripts {
    @if (Model.CanEdit)
    {
        <script src="~/js/scan-input.js" asp-append-version="true"></script>
        <script src="~/js/picker.js" asp-append-version="true"></script>
        <script src="~/js/doc-scan.js" asp-append-version="true"></script>
        <script src="~/js/scan-field.js" asp-append-version="true"></script>
        <script src="~/js/camera-field.js" asp-append-version="true"></script>
    }
}
