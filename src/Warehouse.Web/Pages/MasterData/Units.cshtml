@page
@model Warehouse.Web.Pages.MasterData.UnitsModel
@{
    ViewData["Title"] = "計量單位";
    var editing = Model.EditId is not null;
}
<h1>計量單位</h1>
@if (TempData["Message"] is string message)
{
    <div class="message info">@message</div>
}
@if (Model.Error is not null)
{
    <div class="message error" id="page-error">@Model.Error</div>
}

<form method="post" asp-page-handler="Save" asp-route-edit="@Model.EditId" class="panel" id="unit-form">
    <h2>@(editing ? "修改單位" : "新增單位")</h2>
    <div asp-validation-summary="All" class="field-error"></div>
    <input type="hidden" asp-for="Version" />
    <div class="form-grid">
        <label asp-for="Input.Code"></label>
        <input asp-for="Input.Code" type="text" readonly="@editing" maxlength="16" placeholder="大寫英數，例：PAIR" />
        <label asp-for="Input.Name"></label>
        <input asp-for="Input.Name" type="text" maxlength="50" />
        <label asp-for="Input.DecimalPlaces"></label>
        <input asp-for="Input.DecimalPlaces" type="number" min="0" max="4" readonly="@Model.EditingInUse" />
    </div>
    <div class="actions">
        <button type="submit" id="unit-save">@(editing ? "儲存" : "新增")</button>
        @if (editing)
        {
            <a href="/MasterData/Units">取消</a>
        }
    </div>
    <p class="muted">代碼建立後不可修改；已有物料使用的單位不可修改小數位數。</p>
</form>

<div class="table-wrap">
    <table id="unit-list">
        <thead><tr><th>代碼</th><th>名稱</th><th>小數位數</th><th>使用中</th><th>狀態</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model.Units)
            {
                <tr>
                    <td>@u.Code</td>
                    <td>@u.Name</td>
                    <td>@u.DecimalPlaces</td>
                    <td>@(u.IsInUse ? "是" : "否")</td>
                    <td>@(u.IsActive ? "啟用" : "停用")</td>
                    <td>
                        <a href="/MasterData/Units?edit=@u.Id">修改</a>
                        <form method="post" asp-page-handler="Toggle" class="inline">
                            <input type="hidden" name="id" value="@u.Id" />
                            <input type="hidden" name="version" value="@u.Version" />
                            <input type="hidden" name="isActive" value="@((!u.IsActive).ToString().ToLowerInvariant())" />
                            <button type="submit" class="link">@(u.IsActive ? "停用" : "啟用")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
